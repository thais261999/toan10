rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ ĐIỀN GMAIL CỦA THẦY CÔ VÀO DÒNG DƯỚI, y hệt trong js/fb.js
    function laGiaoVien() {
      return request.auth != null
        && request.auth.token.email.lower() in ['thais261999@gmail.com'];
    }

    match /hocsinh/{uid} {

      // Học sinh đọc hồ sơ của chính mình, thầy cô đọc hết
      allow read: if request.auth != null && (request.auth.uid == uid || laGiaoVien());

      // Lần đầu khai báo: bắt buộc chưa duyệt, chưa có xu
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.duyet == false
        && request.resource.data.xu == 0
        && request.resource.data.phieu == 0
        && request.resource.data.soBai == 0;

      // Học sinh tự ghi tiến độ, nhưng:
      //  - không được tự duyệt cho mình
      //  - xu mỗi lần ghi chỉ được tăng tối đa 50
      allow update: if request.auth != null
        && request.auth.uid == uid
        && resource.data.duyet == true
        && request.resource.data.duyet == resource.data.duyet
        && request.resource.data.xu <= resource.data.xu + 50
        && request.resource.data.soBai <= resource.data.soBai + 1;

      // Thầy cô duyệt, loại
      allow update, delete: if laGiaoVien();
    }

    // Mọi thứ khác đều cấm
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
